# Only REFRESH_TOKEN is needed for the default OAuth client.
# Save this file as .env before running node refresh_single.js.
REFRESH_TOKEN=
# Alternative inputs (set only one input):
# MSAAUTH_COOKIE=
# COOKIE_FILE=./cookies.txt

# For OAuth refresh tokens, use the client that issued the token.
# MICROSOFT_CLIENT_ID=
# MICROSOFT_REDIRECT_URI=
# MICROSOFT_SCOPE=
# PROXY=
